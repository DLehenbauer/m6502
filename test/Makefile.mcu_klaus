# Makefile for MCU + BRAM Klaus functional test using Verilator
# Usage: make -f Makefile.mcu_klaus run
# Usage with waves: WAVES=1 make -f Makefile.mcu_klaus run

VERILATOR = verilator
TOP = test_mcu_klaus
BUILD_DIR = obj_dir_mcu_klaus
RTL_DIR = ../rtl
TEST_DIR = .
BIN_DIR = .

# Verilator parses files in the order given and requires packages to be
# declared before any module whose port list references their types.
RTL_PKG_SOURCES = $(wildcard $(RTL_DIR)/*_pkg.sv)
VERILOG_SOURCES = \
	$(TEST_DIR)/test_mcu_klaus.sv \
	$(RTL_PKG_SOURCES) \
	$(filter-out $(RTL_PKG_SOURCES), $(wildcard $(RTL_DIR)/*.sv))

# Verilator flags
VFLAGS = --cc --exe --build \
	-Wno-fatal \
	--timing \
	-I$(RTL_DIR) \
	--Mdir $(BUILD_DIR) \
	--top-module $(TOP) \
	-CFLAGS "-O3" \
	--public-flat-rw

ifeq ($(WAVES),1)
VFLAGS += --trace
endif

.PHONY: all build run clean

all: run

build: $(BUILD_DIR)/V$(TOP)

$(BUILD_DIR)/V$(TOP): $(VERILOG_SOURCES) tb_mcu_klaus.cpp
	$(VERILATOR) $(VFLAGS) $(VERILOG_SOURCES) tb_mcu_klaus.cpp

run: build
	@echo "Running Klaus 6502 tests (MCU with BRAM)..."
	@cp $(BIN_DIR)/6502_functional_test.bin $(BUILD_DIR)/
	@cp $(BIN_DIR)/6502_interrupt_test.bin  $(BUILD_DIR)/
	@cp $(BIN_DIR)/6502_decimal_test.bin    $(BUILD_DIR)/
	cd $(BUILD_DIR) && ./V$(TOP)

clean:
	rm -rf $(BUILD_DIR)
